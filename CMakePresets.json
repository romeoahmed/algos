{
  "version": 12,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "vs2026",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "inherits": "debug", "configuration": "Release" },
    { "name": "vs2026-debug", "inherits": "debug", "configurePreset": "vs2026" },
    { "name": "vs2026-release", "inherits": "release", "configurePreset": "vs2026" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "release", "inherits": "debug", "configuration": "Release" },
    { "name": "vs2026-debug", "inherits": "debug", "configurePreset": "vs2026" },
    { "name": "vs2026-release", "inherits": "release", "configurePreset": "vs2026" }
  ]
}
